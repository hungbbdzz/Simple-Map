{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/velorise-simple-map",
    "sources": "https://github.com/hungbbdzz/Simple-Map",
    "issues": "https://github.com/hungbbdzz/Simple-Map/issues"
  },
  "license": "${mod_license}",
  "icon": "logo.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.velorise.simplemap.SimpleMap"
    ],
    "client": [
      "com.velorise.simplemap.client.SimpleMapClientMod"
    ],
    "modmenu": [
      "com.velorise.simplemap.client.SimpleMapModMenuIntegration"
    ]
  },
  "mixins": [
    "simplemap.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "~1.20.1",
    "java": ">=17",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": "*"
  }
}
